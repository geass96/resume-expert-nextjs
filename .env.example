# 大模型配置（复制为 .env.local 后填写）
# 未配置 LLM_API_KEY 时自动使用 Mock 数据

# 必填：API Key（配置后自动切换为真实大模型）
LLM_API_KEY=sk-your-key-here

# ===== DeepSeek 示例（推荐）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek

# ===== 其他 Provider =====
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#           LLM_MODEL=gpt-4o-mini
#           LLM_PROVIDER=openai
#
# Moonshot: LLM_BASE_URL=https://api.moonshot.cn/v1
#           LLM_MODEL=moonshot-v1-8k
#           LLM_PROVIDER=moonshot

# 可选：强制使用 Mock（即使有 API Key）
# USE_MOCK_AI=true

# 单用户服务端配置（生产值不得提交）
# RESUME_PUBLIC_ORIGIN=https://resume-expert.geis.de5.net
# RESUME_DATA_DIR=/opt/resume-expert/shared
# RESUME_PASSWORD_SALT=replace-with-random-salt
# RESUME_PASSWORD_HASH=replace-with-scrypt-hex
# RESUME_SESSION_SECRET=replace-with-random-secret

# 默认使用单用户共享限流桶，忽略请求方提交的 IP 头。
# 仅在已验证源站无法绕过 Cloudflare 后启用：
# RESUME_TRUST_CLOUDFLARE_IP=true
